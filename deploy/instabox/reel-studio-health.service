[Unit]
Description=Record reel studio health without keeping the VM awake
After=reel-studio.service

[Service]
Type=oneshot
User=reelstudio
Group=reelstudio
WorkingDirectory=/data/reel-studio/current
Environment=PORT=4317
Environment=DISK_RESERVE_MB=2048
ExecStart=/data/reel-studio/toolchain/node-v24.16.0-linux-x64/bin/node scripts/healthcheck.cjs
UMask=0077
NoNewPrivileges=true
