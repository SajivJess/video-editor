{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "Remotion Video Editing Framework",
  "main": "src/index.ts",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "review": "remotion render src/index.ts ReelDemo Output/demo_reel_review.mp4",
    "build": "remotion render src/index.ts ReelBase Output/final.mp4",
    "still": "remotion still src/index.ts ReelDemo Output/preview.jpg",
    "test": "node --test tests/engine.test.ts tests/production.test.cjs tests/dashboard.test.cjs tests/research.test.cjs tests/sharing.test.cjs tests/standalone.test.cjs",
    "typecheck": "tsc --noEmit",
    "project": "node scripts/project.cjs",
    "prebuild": "node scripts/project.cjs check",
    "prereview": "node scripts/project.cjs check",
    "validate": "node scripts/project.cjs check",
    "transcribe": ".venv/Scripts/python.exe scripts/transcribe.py",
    "edit": ".venv/Scripts/python.exe scripts/edit.py",
    "finish": ".venv/Scripts/python.exe scripts/finish.py",
    "qa": ".venv/Scripts/python.exe scripts/qa.py",
    "predashboard": "node server/build-client.js",
    "dashboard": "node server/index.js",
    "test:dashboard:render": "node scripts/smoke-dashboard.cjs",
    "build:dashboard": "node server/build-client.js",
    "share:setup": "node scripts/setup-ngrok.cjs",
    "preshare": "node server/build-client.js",
    "share": "node scripts/share.cjs",
    "ai:setup": "node scripts/setup-ai.cjs",
    "prestandalone": "node server/build-client.js",
    "standalone": "node server/index.js",
    "doctor": "node scripts/doctor.cjs",
    "cloud:setup": "node scripts/setup-instabox.cjs",
    "cloud:prepare": "node scripts/instabox.cjs prepare",
    "cloud:deploy": "node scripts/instabox.cjs deploy",
    "cloud:status": "node scripts/instabox.cjs status",
    "cloud:package": "node scripts/instabox.cjs package",
    "cloud:benchmark": "node scripts/instabox.cjs benchmark"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ngrok/ngrok": "^1.8.0",
    "@remotion/cli": "^4.0.540",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "linkedom": "^0.18.15",
    "multer": "^2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.540",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
