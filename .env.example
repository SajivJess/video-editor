# Copy to .env in the project root and fill the empty required values locally.
# This example contains NO saved credentials. Never commit your filled .env.
# Alternatively: npm.cmd run ai:setup prompts privately for keys/password.
# Root .env values take precedence over the Windows setup file (ai.env).

# REQUIRED: Google AI Studio Gemini key for verification/audit and default writing.
GEMINI_API_KEY=""
# OPTIONAL: additional Gemini keys for quota-response failover.
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# REQUIRED: choose your own studio login password, at least 12 characters.
# Empty password + REQUIRE_AUTH=true deliberately prevents startup.
STUDIO_PASSWORD=""
REQUIRE_AUTH=true

# Existing project model defaults; live provider availability is not validated.
GEMINI_VERIFY_MODEL=gemini-3.5-flash-lite
GEMINI_WRITE_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLE_SEARCH=false
AI_DAILY_REQUEST_LIMIT=30

# Optional OpenRouter script writer. Gemini remains required for verification.
# To enable: set SCRIPT_PROVIDER=openrouter, fill its key and an explicit :free ID.
# Current zero pricing is checked by the backend; there is no paid fallback.
SCRIPT_PROVIDER=gemini
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Initial Dell server settings: local access, one worker, CPU-int8 Whisper.
HOST=127.0.0.1
PORT=4317
WHISPER_MODEL=medium
WHISPER_THREADS=2
RENDER_CONCURRENCY=1
DISK_RESERVE_MB=2048

# Keep false for local HTTP. Set true when serving the studio over HTTPS.
STUDIO_SECURE_COOKIE=false

# Optional runtime overrides; the normal .venv/browser defaults are used otherwise.
# REEL_PYTHON="C:/path/to/video-editor/.venv/Scripts/python.exe"
# REMOTION_BROWSER_EXECUTABLE="C:/Program Files/Google/Chrome/Application/chrome.exe"

# No Meta, Claude, image-generation or InstaBox credential is required here.
# ngrok is NOT enabled/configured by this file. If you choose it again later,
# npm.cmd run share:setup configures its separate account token and fixed domain.
